{
  "extends": "../tsconfig.json",
  "references": [
    { "path": "./tsconfig.app.json" }
  ],
  "compilerOptions": {
    "outDir": "../out-tsc/spec",
    "composite": true,
    "declaration": true,
    "types": [
      "jasmine",
      "node"
    ]
  },
  "files": [
    "test.ts",
    "polyfills.ts"
  ],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    },
    "strictTemplates": false
  },
  "include": [
    "**/*.spec.ts",
    "**/*.d.ts"
  ]
}
